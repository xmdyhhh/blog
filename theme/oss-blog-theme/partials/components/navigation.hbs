<header id="gh-navigation" class="gh-navigation oss-navigation is-{{#match navigationLayout "Logo on the left"}}left-logo{{else match navigationLayout "Stacked"}}stacked{{else}}middle-logo{{/match}}{{#match @custom.header_and_footer_color "Accent color"}} has-accent-color{{/match}} gh-outer">
    <div class="gh-navigation-inner gh-inner">

        <div class="gh-navigation-brand">
            <a class="gh-navigation-logo is-title oss-logo" href="{{@site.url}}">
                {{#if @site.logo}}
                    <img src="{{@site.logo}}" alt="{{@site.title}}">
                {{else}}
                    {{@site.title}}
                {{/if}}
            </a>
            {{> "search-toggle"}}
            <button class="gh-burger gh-icon-button oss-menu-toggle" aria-label="{{t "菜单"}}" aria-expanded="false">
                {{> "icons/burger"}}
                {{> "icons/close"}}
            </button>
        </div>

        <nav class="gh-navigation-menu oss-nav-menu" aria-label="{{t "主导航"}}">
            {{navigation}}
            {{#unless @site.members_enabled}}
                {{#match navigationLayout "Stacked"}}
                    {{> "search-toggle"}}
                {{/match}}
            {{/unless}}
        </nav>

        <div class="gh-navigation-actions oss-nav-actions">
            {{#unless @site.members_enabled}}
                {{^match navigationLayout "Stacked"}}
                    {{> "search-toggle"}}
                {{/match}}
            {{else}}
                {{> "search-toggle"}}
                <div class="gh-navigation-members oss-members-area">
                    {{#unless @member}}
                        {{#unless @site.members_invite_only}}
                            <a href="#/portal/signin" data-portal="signin" class="oss-signin-link">{{t "登录"}}</a>
                            {{#unless hideSubscribeButton}}
                                <a class="gh-button oss-subscribe-btn" href="#/portal/signup" data-portal="signup">{{t "注册订阅"}}</a>
                            {{/unless}}
                        {{else}}
                            <a class="gh-button oss-signin-btn" href="#/portal/signin" data-portal="signin">{{t "登录"}}</a>
                        {{/unless}}
                    {{else}}
                        <a class="gh-button oss-account-btn" href="#/portal/account" data-portal="account">{{t "我的账户"}}</a>
                    {{/unless}}
                </div>
            {{/unless}}
        </div>

    </div>
</header>
