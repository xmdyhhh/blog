# Ghost Blog Environment Configuration
# Copy this file to .env and fill in your values

# Ghost URL (local development)
GHOST_URL=http://localhost:2368

# Database (SQLite by default for local)
DB_CLIENT=sqlite3
DB_FILENAME=./content/data/ghost-local.db

# Server port
PORT=2368

# Admin credentials (for initial setup only)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=YourSecurePassword123!

# Content API Key (for custom theme/frontend)
CONTENT_API_KEY=your_content_api_key_here

# Admin API Key (for server-side scripts only, never expose to browser)
ADMIN_API_KEY=your_admin_api_key_here
